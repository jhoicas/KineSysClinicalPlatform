# KineSys Backend Environment Variables

PORT=8080

# Database URL for Supabase (Transaction connection pooler or direct connection)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase Auth configuration (used by middleware to verify JWTs)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# CORS allowed origins (frontend URL)
CORS_ORIGINS=http://localhost:3000
