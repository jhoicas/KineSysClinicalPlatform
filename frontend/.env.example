# ─── KineSys Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.

# Supabase Auth (required for login)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Go Backend API Base URL. This is baked into the production bundle.
# Set it to the public URL of the deployed Go backend, or leave empty when
# the frontend host reverse-proxies /api to the backend.
VITE_API_BASE_URL=http://localhost:8080

# Gemini AI API Key (optional, for AI features)
GEMINI_API_KEY=your_gemini_api_key

# Application URL (set by hosting platform)
APP_URL=http://localhost:3000
